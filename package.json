{
  "name": "lowdata",
  "version": "0.2.1",
  "description": "Resilience for the other half of the internet: automatic retries, an offline request queue, and bandwidth-aware media for web apps on poor connections.",
  "keywords": [
    "offline",
    "offline-first",
    "retry",
    "backoff",
    "fetch",
    "indexeddb",
    "low-bandwidth",
    "africa",
    "form",
    "image-compression",
    "pwa",
    "multi-tenant",
    "react-native",
    "electron",
    "vue",
    "svelte",
    "angular",
    "solid"
  ],
  "license": "MIT",
  "author": "Moses Bass <bassmoses996@gmail.com>",
  "homepage": "https://github.com/bassmoses/lowdata#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bassmoses/lowdata.git"
  },
  "bugs": {
    "url": "https://github.com/bassmoses/lowdata/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/lowdata.global.js",
  "jsdelivr": "./dist/lowdata.global.js",
  "typesVersions": {
    "*": {
      "network": [
        "./dist/network.d.ts"
      ],
      "forms": [
        "./dist/forms.d.ts"
      ],
      "media": [
        "./dist/media.d.ts"
      ],
      "react": [
        "./dist/react.d.ts"
      ],
      "vue": [
        "./dist/vue.d.ts"
      ],
      "svelte": [
        "./dist/svelte.d.ts"
      ],
      "angular": [
        "./dist/angular.d.ts"
      ],
      "solid": [
        "./dist/solid.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./network": {
      "types": "./dist/network.d.ts",
      "import": "./dist/network.js",
      "require": "./dist/network.cjs"
    },
    "./forms": {
      "types": "./dist/forms.d.ts",
      "import": "./dist/forms.js",
      "require": "./dist/forms.cjs"
    },
    "./media": {
      "types": "./dist/media.d.ts",
      "import": "./dist/media.js",
      "require": "./dist/media.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "import": "./dist/svelte.js",
      "require": "./dist/svelte.cjs"
    },
    "./angular": {
      "types": "./dist/angular.d.ts",
      "import": "./dist/angular.js",
      "require": "./dist/angular.cjs"
    },
    "./solid": {
      "types": "./dist/solid.d.ts",
      "import": "./dist/solid.js",
      "require": "./dist/solid.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "pnpm typecheck && pnpm build && pnpm test",
    "release": "semantic-release"
  },
  "peerDependencies": {
    "react": ">=17",
    "vue": ">=3",
    "rxjs": ">=7",
    "solid-js": ">=1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vitest/coverage-v8": "^2.1.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rxjs": "^7.8.2",
    "semantic-release": "^25.0.9",
    "serve": "^14.2.6",
    "solid-js": "^1.9.15",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2",
    "vue": "^3.5.42"
  }
}
